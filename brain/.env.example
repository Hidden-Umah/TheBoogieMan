# Copy to brain/.env and fill in. brain/.env is gitignored: keys never leave your machine.

# ── Brain (the LLM). Set at least one key. LLM_PROVIDER=auto picks Anthropic first, then Groq.
# LLM_PROVIDER=auto            # auto | groq | anthropic | openai
GROQ_API_KEY=                  # free tier at console.groq.com (GROK_API_KEY also works)
ANTHROPIC_API_KEY=
# LLM_MODEL=                   # default: openai/gpt-oss-120b on Groq, claude-haiku-5-5 on Anthropic

# Any other OpenAI-compatible API (Gemini, OpenRouter...): LLM_PROVIDER=openai plus
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ── Voice (ElevenLabs): hearing and speaking.
ELEVENLABS_API_KEY=
# Brian (deep, resonant). Swap for any voice id in your ElevenLabs account.
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# ── Optional
# BOOGEYMAN_MIC=               # mic by name or index (list: .venv/bin/python -m sounddevice)
# BOOGEYMAN_VOICE=1            # 0 turns voice off
