# Copy to brain/.env and fill in. brain/.env is gitignored: keys never leave your machine.

# Claude: the brain's replies. Without it, the Boogeyman uses a few built-in lines.
ANTHROPIC_API_KEY=
# BOOGEYMAN_MODEL=claude-haiku-5-5

# ElevenLabs: hearing (speech-to-text) and speaking (text-to-speech).
ELEVENLABS_API_KEY=
# Brian (deep, resonant). Swap for any voice id in your ElevenLabs account.
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# Optional: pick a microphone by name or index (see: .venv/bin/python -m sounddevice)
# BOOGEYMAN_MIC=
# Set to 0 to turn voice off entirely
# BOOGEYMAN_VOICE=1
